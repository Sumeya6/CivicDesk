DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>
SYSTEM_ACTOR_PHONE=+251900000000
LOG_LEVEL=info
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_TOKEN_SECRET=replace-with-a-local-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-local-refresh-secret
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_PASSWORD_RESET_SECRET=replace-with-a-local-reset-secret
JWT_PASSWORD_RESET_EXPIRATION=1h

# SMS Notifications (Twilio) - Optional for local development (uses mock provider when absent)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15551234567